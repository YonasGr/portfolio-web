---
import ProjectCard from './project-card.astro';
import projectsData from '../data/projects.json';

const [heroProject, ...restProjects] = projectsData;
---

<section
  id="projects"
  class="reveal w-full py-20 sm:py-28 md:py-32 px-5 sm:px-8 md:px-14 lg:px-20 max-w-[1440px] mx-auto"
>
  <!-- Section header -->
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 mb-14 sm:mb-16">
    <div>
      <div class="label mb-3">02 — Selected Work</div>
      <h2
        class="font-heading font-black tracking-[-0.04em] leading-[0.92]"
        style="font-size: clamp(2.4rem, 6vw, 4.5rem); color: var(--text-1);"
      >
        Featured<br /><span style="color: var(--accent);">Projects.</span>
      </h2>
    </div>

    <div
      class="hidden sm:flex items-center gap-3 shrink-0 px-4 py-2 rounded-full font-mono text-xs"
      style="border: 1px solid var(--border); color: var(--text-2); background: var(--surface);"
    >
      <span class="w-2 h-2 rounded-full" style="background: var(--accent);"></span>
      {projectsData.length} production case studies
    </div>
  </div>

  <!-- Hero project — full width -->
  {heroProject && (
    <div class="mb-5 sm:mb-6">
      <ProjectCard project={heroProject} variant="hero" />
    </div>
  )}

  <!-- Rest — asymmetric grid -->
  {restProjects.length > 0 && (
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5">
      {restProjects.map(p => (
        <ProjectCard project={p} variant="default" />
      ))}
    </div>
  )}
</section>
