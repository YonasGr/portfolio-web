---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import { resolveAssetImage } from '../utils/images';

interface Props {
  project: {
    id: string; title: string; tagline: string; description: string;
    category: string; featured?: boolean; year: string; impact?: string;
    metrics?: string[] | { label: string; value: string }[];
    highlights?: string[]; tech: string[]; platforms?: string[];
    link?: string; github?: string; images: string[];
  };
  variant?: 'hero' | 'default';
}

const { project, variant = 'default' } = Astro.props;

const resolvedImages = await Promise.all(project.images.map(img => resolveAssetImage(img)));
const validImages = resolvedImages.filter(Boolean);
const primaryImage = validImages[0] ?? null;

// Filter tags for category
const cl = project.category.toLowerCase();
let filterTags = ['all'];
if (cl.includes('mobile') || cl.includes('ai')) filterTags.push('mobile-ai');
if (cl.includes('creative') || cl.includes('webgl') || cl.includes('frontend') || cl.includes('ui/ux')) filterTags.push('creative-web');
if (cl.includes('full-stack') || cl.includes('backend') || cl.includes('api')) filterTags.push('full-stack');
if (cl.includes('tooling') || cl.includes('systems') || cl.includes('cli')) filterTags.push('tooling');

const isHero = variant === 'hero';
---

<article
  class:list={["project-card group relative overflow-hidden w-full h-full", isHero ? "hero-card" : "default-card"]}
  style="border: 1px solid var(--border); border-radius: 1rem; background: var(--surface); transition: border-color 0.22s ease, box-shadow 0.22s ease, transform 0.22s ease;"
  data-filter-tags={filterTags.join(' ')}
>
  <!-- Image zone -->
  <div class:list={["relative overflow-hidden w-full shrink-0", isHero ? "aspect-[16/7] sm:aspect-[21/8]" : "aspect-[16/9]"]}>
    {primaryImage ? (
      <Image
        src={primaryImage}
        alt={`${project.title} preview`}
        class="w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-[1.04]"
        loading="lazy"
      />
    ) : (
      <div class="w-full h-full flex items-center justify-center" style="background: var(--surface-2);">
        <Icon name="mdi:image-outline" class="w-10 h-10" style="color: var(--text-3);" />
      </div>
    )}

    <!-- Dark overlay -->
    <div
      class="absolute inset-0 pointer-events-none"
      style="background: linear-gradient(to top, var(--bg) 0%, rgba(8,8,9,0.4) 40%, transparent 70%); opacity: 0.85; transition: opacity 0.3s;"
    ></div>

    <!-- Badges top-left -->
    <div class="absolute top-3 left-3 right-3 flex items-center justify-between z-10 pointer-events-none">
      <span
        class="px-2.5 py-1 rounded-full font-mono text-[10px] tracking-wider uppercase"
        style="background: rgba(8,8,9,0.75); color: var(--accent); border: 1px solid rgba(var(--accent-rgb),0.2); backdrop-filter: blur(6px);"
      >
        {project.category}
      </span>
      <span
        class="px-2.5 py-1 rounded-full font-mono text-[10px]"
        style="background: rgba(8,8,9,0.75); color: var(--text-2); border: 1px solid var(--border); backdrop-filter: blur(6px);"
      >
        {project.year}
      </span>
    </div>

    <!-- Arrow icon on hover -->
    {(project.link || project.github) && (
      <div
        class="absolute top-3 right-3 z-20 opacity-0 group-hover:opacity-100 transition-opacity duration-200 pointer-events-none"
      >
        <div class="w-7 h-7 rounded-full flex items-center justify-center" style="background: var(--accent); color: var(--on-accent);">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-3.5 h-3.5">
            <path d="M16.004 9.41421L7.39768 18.0208L5.98347 16.6066L14.5898 8H7.00404V6H18.004V17H16.004V9.41421Z"/>
          </svg>
        </div>
      </div>
    )}
  </div>

  <!-- Body -->
  <div class="p-5 sm:p-6 flex flex-col gap-3 sm:gap-4">
    <div>
      <h3
        class="font-heading font-black tracking-tight leading-tight mb-0.5 transition-colors duration-200 group-hover:color-accent"
        style={`font-size: ${isHero ? 'clamp(1.4rem,3vw,2.2rem)' : 'clamp(1.1rem,2vw,1.4rem)'}; color: var(--text-1);`}
      >
        {project.title}
      </h3>
      <p class="font-body text-xs sm:text-sm font-medium" style="color: var(--accent);">
        {project.tagline}
      </p>
    </div>

    <p
      class:list={["font-body text-sm leading-relaxed", isHero ? "line-clamp-3" : "line-clamp-2"]}
      style="color: var(--text-2);"
    >
      {project.description}
    </p>

    <!-- Metrics (hero only) -->
    {isHero && project.metrics && project.metrics.length > 0 && (
      <div class="grid grid-cols-3 sm:grid-cols-4 gap-2">
        {(project.metrics as any[]).slice(0, 4).map((m: any) => {
          const isObj = typeof m === 'object';
          return (
            <div
              class="flex flex-col items-center justify-center py-2.5 px-2 rounded-lg text-center"
              style="background: var(--accent-dim-2); border: 1px solid rgba(var(--accent-rgb),0.15);"
            >
              <span class="font-mono text-xs font-bold" style="color: var(--text-1);">{isObj ? m.value : m}</span>
              {isObj && m.label && <span class="font-mono text-[9px] uppercase tracking-wider mt-0.5" style="color: var(--text-2);">{m.label}</span>}
            </div>
          );
        })}
      </div>
    )}

    <!-- Tech + actions row -->
    <div class="flex flex-wrap items-center justify-between gap-3 pt-3" style="border-top: 1px solid var(--border);">
      <div class="flex flex-wrap gap-1.5">
        {project.tech.slice(0, isHero ? 6 : 4).map((t: string) => (
          <span class="tag">{t}</span>
        ))}
        {project.tech.length > (isHero ? 6 : 4) && (
          <span class="tag">+{project.tech.length - (isHero ? 6 : 4)}</span>
        )}
      </div>

      <div class="flex items-center gap-1.5 shrink-0">
        {project.github && (
          <a
            href={project.github}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-ghost text-xs py-1.5 px-3"
            style="padding: 0.35rem 0.75rem; font-size: 0.75rem; border-radius: 9999px;"
          >
            <Icon name="mdi:github" class="w-3.5 h-3.5" />
            Code
          </a>
        )}
        {project.link && (
          <a
            href={project.link}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary text-xs"
            style="padding: 0.35rem 0.85rem; font-size: 0.75rem; border-radius: 9999px;"
          >
            Demo ↗
          </a>
        )}
      </div>
    </div>
  </div>
</article>

<style>
  .project-card:hover {
    border-color: var(--border-accent) !important;
    box-shadow: 0 16px 48px -16px rgba(0,0,0,0.6);
    transform: translateY(-4px);
  }

  .project-card:hover h3 {
    color: var(--accent) !important;
  }

  .project-card:hover .absolute.inset-0 {
    opacity: 0.5 !important;
  }
</style>