---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import localData from '../data/home.json';
import yonasgrAvatar from '../assets/yonasgr.png';

interface Social {
  name: string;
  url: string;
  icon: string;
  handle?: string;
  showInHero?: boolean;
  showInContact?: boolean;
}

interface Stat {
  label: string;
  value: string;
}

interface Availability {
  status: string;
  badgeText: string;
  openTo?: string[];
}

interface ProfileData {
  name: string;
  title: string;
  headline?: string;
  location?: string;
  availability?: Availability;
  stats?: Stat[];
  bio?: string;
  intro?: string;
  photoUrl?: string;
  webpageTitle?: string;
  resumeUrl?: string;
  socials?: Social[];
}

const isApiLive = import.meta.env.PROD;
const BASE_URL = import.meta.env.PUBLIC_API_BASE_URL;

let data: ProfileData;

if (isApiLive && BASE_URL) {
  try {
    const response = await fetch(`${BASE_URL}/home`);
    if (!response.ok) throw new Error('Network response was not ok');
    data = (await response.json()) as ProfileData;
  } catch (error) {
    console.error("API Fetch failed, falling back to local data", error);
    data = localData as unknown as ProfileData;
  }
} else {
  data = localData as unknown as ProfileData;
}

const {
  name = "Yonas Girma",
  title = "Full-Stack Software Engineer & Creative Developer",
  headline = "Crafting resilient full-stack systems, fluid interactive web experiences, and high-performance mobile apps.",
  location = "Addis Ababa, Ethiopia · Available Worldwide",
  stats = [
    { label: "Years Experience", value: "3+" },
    { label: "Apps Shipped", value: "8+" },
    { label: "Users Reached", value: "25k+" },
    { label: "Technologies", value: "15+" }
  ],
  bio = "",
  intro = "",
  resumeUrl = "/yonasgr-resume.pdf",
  socials = []
} = data;

const heroBio = bio || intro;
const heroSocials = socials.filter(s => s.showInHero !== false && s.url && s.url !== "#" && s.url !== "");

// Split name for typographic treatment
const nameParts = name.split(" ");
const firstName = nameParts[0] ?? name;
const lastName = nameParts.slice(1).join(" ");
---

<section id="home" class="hero-section relative w-full pt-28 sm:pt-32 md:pt-36 pb-16 sm:pb-20 md:pb-28">

  <!-- Editorial Grid Layout -->
  <div class="hero-grid grid grid-cols-1 lg:grid-cols-12 gap-x-12 xl:gap-x-16 gap-y-12 items-start w-full">

    <!-- Left Column: Content (7 cols) -->
    <div class="lg:col-span-7 flex flex-col items-start space-y-7 sm:space-y-8 w-full">

      <!-- Disciplined Kicker Line -->
      <div class="flex items-center gap-3">
        <div class="h-px w-8 bg-accent opacity-60"></div>
        <span class="font-mono text-[11px] tracking-[0.2em] text-accent uppercase font-medium">{title}</span>
      </div>

      <!-- Name Typography Block -->
      <div class="hero-name-block w-full">
        <h1 class="hero-name font-heading font-bold text-maintext leading-[0.95] tracking-tight">
          <span class="block">{firstName}</span>
          {lastName && <span class="block text-accent/90">{lastName}</span>}
        </h1>
      </div>

      <!-- Headline / Value Proposition -->
      <p class="hero-headline font-heading font-medium text-maintext/75 leading-snug max-w-xl">
        {headline}
      </p>

      <!-- Narrative Bio -->
      {heroBio && (
        <p class="font-body text-subtext text-sm sm:text-base leading-relaxed max-w-lg">
          {heroBio}
        </p>
      )}

      <!-- Location — plain, no icons -->
      <p class="font-mono text-[11px] tracking-[0.12em] text-subtext/60 uppercase">{location}</p>

      <!-- CTAs -->
      <div class="flex flex-wrap items-center gap-3 sm:gap-4 pt-1 w-full">
        <a
          href="#projects"
          class="hero-cta-primary group inline-flex items-center justify-center gap-2.5 px-6 py-3 sm:px-7 sm:py-3.5 font-body font-semibold text-sm transition-all duration-200"
        >
          <span>View Work</span>
          <Icon name="mdi:arrow-right" class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1" />
        </a>

        <a
          href={resumeUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="hero-cta-secondary inline-flex items-center justify-center gap-2 px-6 py-3 sm:px-7 sm:py-3.5 font-body font-medium text-sm transition-all duration-200"
        >
          <Icon name="mdi:file-document-outline" class="w-4 h-4" />
          <span>Resume</span>
        </a>
      </div>

      <!-- Social Links — minimal icon row -->
      {heroSocials.length > 0 && (
        <div class="flex items-center gap-1.5">
          {heroSocials.map((social) => (
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class="hero-social-link p-2 text-subtext/50 hover:text-maintext transition-colors duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded"
              aria-label={`Visit ${social.name}`}
              title={social.name}
            >
              <Icon name={social.icon} class="w-4 h-4 sm:w-[18px] sm:h-[18px]" />
            </a>
          ))}
        </div>
      )}
    </div>

    <!-- Right Column: Profile Image (5 cols) -->
    <div class="lg:col-span-5 flex justify-center lg:justify-end w-full">
      <div class="profile-frame-outer relative w-full max-w-[280px] sm:max-w-[320px] lg:max-w-[380px]">

        <!-- Large editorial index number — purely typographic -->
        <div class="absolute -top-6 -left-3 sm:-top-8 sm:-left-4 z-0 pointer-events-none select-none" aria-hidden="true">
          <span class="font-heading font-bold text-[96px] sm:text-[120px] leading-none text-maintext/[0.04] tracking-tighter">01</span>
        </div>

        <!-- Profile Image Frame -->
        <div class="profile-frame relative z-10">

          <!-- Main Image Container -->
          <div class="profile-image-wrap relative overflow-hidden">
            <Image
              src={yonasgrAvatar}
              alt={name}
              width={760}
              height={950}
              quality={90}
              class="profile-img w-full h-full object-cover object-center block"
              loading="eager"
            />

            <!-- Refined gradient fade at bottom -->
            <div class="absolute inset-x-0 bottom-0 h-2/5 bg-gradient-to-t from-background via-background/60 to-transparent pointer-events-none"></div>
          </div>

          <!-- Below-image metadata — editorial caption style -->
          <div class="profile-caption flex items-baseline justify-between mt-4 px-0.5">
            <div>
              <div class="font-mono text-[10px] tracking-[0.18em] text-subtext/50 uppercase mb-1">Engineer & Builder</div>
              <div class="font-heading font-semibold text-maintext text-sm">{name}</div>
            </div>
            <div class="font-mono text-[10px] text-subtext/40 tracking-wider text-right">
              ET · UTC+3
            </div>
          </div>
        </div>

        <!-- Thin accent rule decorating the right edge — purely architectural -->
        <div class="absolute top-8 -right-3 sm:-right-4 bottom-8 w-px bg-accent/20 z-0 pointer-events-none" aria-hidden="true"></div>

      </div>
    </div>

  </div>

  <!-- Stats Strip — clean, borderless, typographic -->
  <div class="stats-strip mt-14 sm:mt-16 md:mt-20 grid grid-cols-2 sm:grid-cols-4 gap-x-4 gap-y-6 sm:gap-0 w-full">
    {stats.map((stat, idx) => (
      <div class={`stat-item flex flex-col ${idx < stats.length - 1 ? 'sm:border-r border-card-border sm:pr-8 md:pr-10' : ''} ${idx > 0 ? 'sm:pl-8 md:pl-10' : ''}`}>
        <span class="font-heading font-bold text-maintext text-3xl sm:text-4xl tracking-tight leading-none">{stat.value}</span>
        <span class="font-mono text-[10px] tracking-[0.14em] text-subtext/55 uppercase mt-2">{stat.label}</span>
      </div>
    ))}
  </div>

</section>

<style>
  /* Hero name fluid sizing — clamps beautifully across breakpoints */
  .hero-name {
    font-size: clamp(3.5rem, 9vw, 7.5rem);
    letter-spacing: -0.03em;
  }

  .hero-headline {
    font-size: clamp(1rem, 2.2vw, 1.35rem);
    letter-spacing: -0.01em;
  }

  /* Profile image — tall editorial portrait ratio */
  .profile-image-wrap {
    aspect-ratio: 4 / 5;
    border-radius: 2px; /* near-square corners — intentional, editorial */
  }

  .profile-img {
    filter: none;
    transition: filter 0.3s ease;
  }

  /* Primary CTA — solid accent filled */
  .hero-cta-primary {
    background-color: var(--color-accent);
    color: var(--color-background);
    border-radius: 2px;
    box-shadow: 0 2px 12px rgba(var(--color-accent-rgb), 0.25);
  }

  .hero-cta-primary:hover {
    opacity: 0.9;
    box-shadow: 0 4px 20px rgba(var(--color-accent-rgb), 0.35);
    transform: translateY(-1px);
  }

  .hero-cta-primary:active {
    transform: translateY(0);
    opacity: 1;
  }

  /* Secondary CTA — ghost / outline style */
  .hero-cta-secondary {
    color: var(--color-maintext);
    border: 1px solid var(--color-card-border);
    border-radius: 2px;
  }

  .hero-cta-secondary:hover {
    border-color: rgba(var(--color-accent-rgb), 0.4);
    color: var(--color-accent);
    background-color: rgba(var(--color-accent-rgb), 0.04);
  }

  /* Social links */
  .hero-social-link:hover {
    color: var(--color-accent);
  }

  /* Stats strip */
  .stat-item {
    border-color: var(--color-card-border);
  }

  /* Subtle entrance — no layout jank, just opacity */
  @media (prefers-reduced-motion: no-preference) {
    .hero-section {
      animation: hero-fade-in 0.5s ease both;
    }

    @keyframes hero-fade-in {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
  }

  /* Mobile: stack portrait below text, centered */
  @media (max-width: 1023px) {
    .profile-frame-outer {
      margin: 0 auto;
    }

    .profile-image-wrap {
      aspect-ratio: 3 / 4;
    }
  }
</style>
