---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import localData from '../data/home.json';
import yonasgrAvatar from '../assets/yonasgr.png';

interface Social {
  name: string;
  url: string;
  icon: string;
  handle?: string;
  showInHero?: boolean;
  showInContact?: boolean;
}

interface Stat {
  label: string;
  value: string;
}

interface Availability {
  status: string;
  badgeText: string;
  openTo?: string[];
}

interface ProfileData {
  name: string;
  title: string;
  headline?: string;
  location?: string;
  availability?: Availability;
  stats?: Stat[];
  bio?: string;
  intro?: string;
  photoUrl?: string;
  webpageTitle?: string;
  resumeUrl?: string;
  socials?: Social[];
}

const isApiLive = import.meta.env.PROD;
const BASE_URL = import.meta.env.PUBLIC_API_BASE_URL;

let data: ProfileData;

if (isApiLive && BASE_URL) {
  try {
    const response = await fetch(`${BASE_URL}/home`);
    if (!response.ok) throw new Error('Network response was not ok');
    data = (await response.json()) as ProfileData;
  } catch (error) {
    console.error("API Fetch failed, falling back to local data", error);
    data = localData as unknown as ProfileData;
  }
} else {
  data = localData as unknown as ProfileData;
}

const {
  name = "Yonas Girma",
  title = "Full-Stack Software Engineer & Creative Developer",
  headline = "Crafting resilient full-stack systems, fluid interactive web experiences, and high-performance mobile apps.",
  location = "Addis Ababa, Ethiopia (UTC+3) · Available Worldwide",
  availability = {
    status: "available",
    badgeText: "Available for Q3/Q4 Projects & Full-Time Roles",
    openTo: ["Full-Time Engineering", "Contract / Architecture", "Technical Consulting"]
  },
  stats = [
    { label: "Years Experience", value: "3+" },
    { label: "Production Apps Shipped", value: "8+" },
    { label: "Active Users Reached", value: "25k+" },
    { label: "Core Technologies", value: "15+" }
  ],
  bio = "",
  intro = "",
  resumeUrl = "/yonasgr-resume.pdf",
  socials = []
} = data;

const heroBio = bio || intro;
const heroSocials = socials.filter(s => s.showInHero !== false && s.url && s.url !== "#" && s.url !== "");
---

<section id="home" class="min-h-[90vh] md:min-h-screen pt-20 sm:pt-28 md:pt-32 pb-12 sm:pb-16 md:pb-24 flex flex-col justify-center relative w-full">
  <!-- Top Showcase Banner Bar -->
  <div class="mb-6 sm:mb-10 w-full">
    <div class="flex flex-wrap items-center justify-between gap-2 px-3 sm:px-4 py-2 sm:py-2.5 rounded-2xl bg-card border border-card-border backdrop-blur-md text-xs font-mono text-subtext shadow-sm">
      <div class="flex items-center gap-2">
        <span class="inline-block h-2 w-2 rounded-full bg-emerald-400"></span>
        <span class="text-maintext font-medium">yonasgr.dev</span>
        <span class="text-subtext/40">/</span>
        <span class="text-accent">portfolio</span>
      </div>
      <div class="flex items-center gap-2 sm:gap-3 text-[11px] text-subtext/80">
        <span class="px-2 py-0.5 rounded bg-accent/10 border border-accent/20 text-accent font-medium hidden sm:inline">React · Next.js · Node.js · TypeScript</span>
        <span class="text-subtext/40 hidden sm:inline">|</span>
        <span>UTC+3 Global</span>
      </div>
    </div>
  </div>

  <!-- Main Hero Editorial Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 sm:gap-10 lg:gap-12 items-center w-full">
    
    <!-- Left Column: Editorial Narrative & Actions (Col 7) -->
    <div class="lg:col-span-7 flex flex-col items-start space-y-4 sm:space-y-6 w-full">
      
      <!-- Availability Pill Badge -->
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 sm:px-3.5 sm:py-1.5 rounded-full bg-accent/10 border border-accent/30 text-accent text-[11px] sm:text-xs font-mono font-medium tracking-wide">
          <span class="inline-block h-2 w-2 rounded-full bg-emerald-400 shrink-0"></span>
          <span class="truncate">{availability.badgeText}</span>
        </div>
      </div>

      <!-- Main Heading & Kicker -->
      <div class="space-y-2 sm:space-y-3 w-full">
        <p class="font-mono text-xs sm:text-sm font-semibold tracking-wider text-accent uppercase">
          {title}
        </p>
        <h1 class="text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-heading font-bold text-maintext tracking-tight leading-[1.08] break-words">
          {name}
        </h1>
        <p class="text-base sm:text-xl md:text-2xl font-heading font-medium text-maintext/90 leading-snug pt-1">
          {headline}
        </p>
      </div>

      <!-- Narrative Bio -->
      <div class="max-w-2xl">
        <p class="text-subtext font-body text-sm sm:text-base md:text-lg leading-relaxed">
          {heroBio}
        </p>

        <!-- Location Indicator -->
        <div class="flex items-center gap-1.5 text-subtext/90 text-xs sm:text-sm font-body mt-3 sm:mt-4">
          <Icon name="mdi:map-marker" class="w-4 h-4 text-accent shrink-0" />
          <span>{location}</span>
        </div>
      </div>

      <!-- Action CTAs -->
      <div class="flex flex-wrap items-center gap-3 sm:gap-4 pt-1 sm:pt-2 w-full">
        <!-- Primary Action: Explore Projects -->
        <a 
          href="#projects" 
          class="group inline-flex items-center justify-center gap-2 px-5 py-3 sm:px-7 sm:py-3.5 rounded-full bg-accent text-background font-body font-semibold text-xs sm:text-sm md:text-base shadow-sm hover:opacity-95 active:scale-[0.99] transition-all duration-200"
        >
          <span>Explore Projects</span>
          <Icon name="mdi:arrow-right" class="w-4 h-4 transition-transform group-hover:translate-x-1" />
        </a>

        <!-- Secondary Action: View Resume -->
        <a 
          href={resumeUrl} 
          target="_blank" 
          rel="noopener noreferrer"
          class="group inline-flex items-center justify-center gap-2 px-4 py-3 sm:px-6 sm:py-3.5 rounded-full bg-card border border-card-border hover:border-accent/40 hover:bg-accent/10 text-maintext font-body font-medium text-xs sm:text-sm md:text-base transition-all duration-200 shadow-sm"
        >
          <Icon name="mdi:file-document-outline" class="w-4 h-4 text-accent" />
          <span>View Resume</span>
          <span class="text-[10px] font-mono text-subtext px-1.5 py-0.5 rounded bg-white/5 border border-white/10 hidden sm:inline">PDF</span>
        </a>
      </div>

      <!-- Social Links Row -->
      <div class="flex items-center gap-2 sm:gap-3 pt-1">
        <span class="text-xs font-mono text-subtext/70 mr-1 hidden sm:inline">CONNECT:</span>
        {heroSocials.map((social) => (
          <a 
            href={social.url} 
            target="_blank" 
            rel="noopener noreferrer"
            class="p-2 sm:p-2.5 rounded-full bg-card border border-card-border hover:border-accent/40 hover:bg-accent/10 text-subtext hover:text-accent transition-colors duration-200 shadow-sm focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
            aria-label={`Visit ${social.name}`}
            title={social.name}
          >
            <Icon 
              name={social.icon} 
              class="w-4 h-4 sm:w-5 sm:h-5" 
            />
          </a>
        ))}
      </div>

    </div>

    <!-- Right Column: Elevated Profile Showcase Card (Col 5) -->
    <div class="lg:col-span-5 flex justify-center lg:justify-end w-full">
      <div class="relative w-full max-w-[300px] sm:max-w-sm md:max-w-md lg:max-w-none">
        
        <!-- Ambient Back Glow -->
        <div 
          class="absolute -inset-2 rounded-3xl opacity-20 blur-xl pointer-events-none"
          style="background: radial-gradient(circle, rgba(var(--color-accent-rgb), 0.3) 0%, transparent 70%);"
        ></div>

        <!-- Avatar Framing Card -->
        <div class="relative rounded-2xl sm:rounded-3xl overflow-hidden border border-accent/20 bg-card backdrop-blur-xl shadow-lg transition-all duration-300 hover:border-accent/40">
          
          <!-- Image Asset -->
          <div class="aspect-4/5 overflow-hidden bg-background/50 relative">
            <Image 
              src={yonasgrAvatar} 
              alt={name} 
              width={600} 
              height={750} 
              quality={92} 
              class="w-full h-full object-cover object-center" 
              loading="eager"
            />

            <!-- Subtle Gradient Overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-background/90 via-transparent to-transparent pointer-events-none"></div>

            <!-- Floating Top Chip -->
            <div class="absolute top-3 left-3 sm:top-4 sm:left-4 z-10">
              <div class="px-2.5 py-1 rounded-full bg-background/85 border border-card-border backdrop-blur-md text-[10px] sm:text-[11px] font-mono text-accent font-medium shadow-sm flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
                <span>Full-Stack Engineer</span>
              </div>
            </div>

            <!-- Bottom Information Bar -->
            <div class="absolute inset-x-0 bottom-0 p-3 sm:p-5 z-10 backdrop-blur-xs flex items-center justify-between border-t border-card-border/50">
              <div>
                <div class="text-[10px] sm:text-[11px] font-mono uppercase tracking-wider text-accent font-semibold">
                  Engineering & Architecture
                </div>
                <div class="text-sm sm:text-base font-heading font-bold text-maintext">
                  {name}
                </div>
              </div>
              <div class="flex items-center gap-1 px-2 py-0.5 sm:px-2.5 sm:py-1 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 text-[10px] sm:text-[11px] font-mono font-medium">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                <span>Available</span>
              </div>
            </div>

          </div>
        </div>

      </div>
    </div>

  </div>

  <!-- Quick Stats Strip -->
  <div class="mt-8 sm:mt-12 md:mt-16 grid grid-cols-2 lg:grid-cols-4 gap-2.5 sm:gap-4 md:gap-6 w-full">
    {stats.map((stat, idx) => (
      <div class="p-3.5 sm:p-5 md:p-6 rounded-xl sm:rounded-2xl bg-card border border-card-border hover:border-accent/35 backdrop-blur-md transition-all duration-200 hover:-translate-y-0.5 shadow-sm">
        <div class="font-mono text-[10px] sm:text-xs text-accent/80 uppercase tracking-wider mb-0.5 sm:mb-1">
          0{idx + 1} / METRIC
        </div>
        <div class="text-xl sm:text-2xl md:text-4xl font-heading font-bold text-maintext tracking-tight">
          {stat.value}
        </div>
        <div class="text-xs sm:text-sm font-body text-subtext mt-0.5 sm:mt-1">
          {stat.label}
        </div>
      </div>
    ))}
  </div>
</section>
