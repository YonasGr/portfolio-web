---
import { Icon } from 'astro-icon/components';
import ThemeToggle from './theme-toggle.astro';

interface NavItem {
  label: string;
  href: string;
  icon: string;
}

const navItems: NavItem[] = [
  {
    label: "Home",
    href: "#home",
    icon: "mdi:home",
  },
  {
    label: "Career",
    href: "#career",
    icon: "mdi:work",
  },
  {
    label: "Projects",
    href: "#projects",
    icon: "mdi:computer",
  },
  {
    label: "Tech",
    href: "#tech",
    icon: "mdi:code-tags",
  },
  {
    label: "Contact",
    href: "#contact",
    icon: "mdi:message",
  },
];
---

<header class="fixed top-3 sm:top-5 left-1/2 -translate-x-1/2 z-50 w-[95%] sm:w-auto max-w-fit pointer-events-none">
  <nav
    id="main-nav"
    aria-label="Main Navigation"
    class="pointer-events-auto flex items-center justify-between sm:justify-center gap-1 sm:gap-2.5 md:gap-3 px-2.5 sm:px-4 py-1.5 sm:py-2 rounded-full bg-card/90 border border-card-border backdrop-blur-xl shadow-lg transition-all duration-200 hover:border-accent/30 max-w-full"
  >
    <!-- Brand Monogram -->
    <a
      href="#home"
      class="flex items-center gap-2 group focus:outline-none focus-visible:ring-2 focus-visible:ring-accent rounded-full shrink-0"
      aria-label="Yonas Girma - Home"
    >
      <div class="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-accent/15 border border-accent/30 text-accent font-heading font-bold text-xs sm:text-sm flex items-center justify-center group-hover:bg-accent group-hover:text-background transition-colors duration-200 shadow-xs">
        YG
      </div>
      <span class="font-heading font-semibold text-maintext text-sm hidden lg:inline tracking-tight group-hover:text-accent transition-colors">
        Yonas<span class="text-accent">.</span>
      </span>
    </a>

    <!-- Divider -->
    <div class="h-3.5 sm:h-4 w-px bg-card-border shrink-0"></div>

    <!-- Navigation Links -->
    <ul class="flex items-center gap-0.5 sm:gap-1.5 md:gap-2">
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class="nav-link relative p-2 sm:px-3 sm:py-1.5 rounded-full text-xs sm:text-sm font-body font-medium text-subtext hover:text-maintext transition-colors duration-150 flex items-center gap-1.5 group focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
              aria-label={item.label}
              title={item.label}
            >
              <Icon 
                name={item.icon} 
                class="w-4 h-4 sm:hidden text-subtext transition-colors" 
              />
              <span class="hidden sm:inline">{item.label}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <!-- Divider -->
    <div class="h-3.5 sm:h-4 w-px bg-card-border shrink-0"></div>

    <!-- Theme Toggle -->
    <div class="shrink-0 flex items-center">
      <ThemeToggle />
    </div>
  </nav>
</header>

<style>
  .nav-link {
    transition: color 0.15s ease, background-color 0.15s ease;
  }

  .nav-link:hover:not(.active) {
    background-color: rgba(var(--color-accent-rgb), 0.08);
    color: var(--color-maintext);
  }

  .nav-link.active {
    color: var(--color-accent) !important;
    background-color: rgba(var(--color-accent-rgb), 0.15);
    font-weight: 600;
  }

  .nav-link.active svg {
    color: var(--color-accent) !important;
  }

  #main-nav.is-scrolled {
    border-color: rgba(var(--color-accent-rgb), 0.35);
    box-shadow: 0 8px 30px -10px rgba(0, 0, 0, 0.35);
  }
</style>

<script>
  function setupNavigation() {
    const nav = document.getElementById("main-nav");
    const sections = document.querySelectorAll("section[id]");
    const navLinks = document.querySelectorAll<HTMLAnchorElement>(".nav-link");

    // Scroll styling enhancement (No layout reflow, pure class toggle)
    let isScrolled = false;
    function handleScroll() {
      const scrolled = window.scrollY > 40;
      if (scrolled !== isScrolled) {
        isScrolled = scrolled;
        nav?.classList.toggle("is-scrolled", isScrolled);
      }
    }
    window.addEventListener("scroll", handleScroll, { passive: true });
    handleScroll();

    // Smooth section scrolling with active update
    document.querySelectorAll<HTMLAnchorElement>('a[href^="#"]').forEach((anchor) => {
      anchor.addEventListener("click", function (e) {
        const target = e.currentTarget as HTMLAnchorElement;
        const targetId = target.getAttribute("href")?.substring(1);
        if (!targetId) return;

        const targetElement = document.getElementById(targetId);
        if (targetElement) {
          e.preventDefault();
          targetElement.scrollIntoView({
            behavior: "smooth",
          });
          
          if (history.pushState) {
            history.pushState(null, '', `#${targetId}`);
          }

          navLinks.forEach((link) => {
            if (link.getAttribute("href") === `#${targetId}`) {
              link.classList.add("active");
            } else {
              link.classList.remove("active");
            }
          });
        }
      });
    });

    // Rock-solid IntersectionObserver for Section Tracking
    // rootMargin: "-20% 0px -60% 0px" triggers when the top of the section enters the upper-middle viewport
    const observerOptions: IntersectionObserverInit = {
      rootMargin: "-20% 0px -60% 0px",
      threshold: 0,
    };

    const observerCallback: IntersectionObserverCallback = (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const id = entry.target.getAttribute("id");
          navLinks.forEach((link) => {
            const href = link.getAttribute("href");
            if (href === `#${id}`) {
              link.classList.add("active");
            } else {
              link.classList.remove("active");
            }
          });
        }
      });
    };

    const observer = new IntersectionObserver(observerCallback, observerOptions);
    sections.forEach((section) => observer.observe(section));

    // Default to #home if near top
    if (window.scrollY < 120) {
      const homeLink = document.querySelector('.nav-link[href="#home"]');
      if (homeLink) homeLink.classList.add("active");
    }
  }

  setupNavigation();
  document.addEventListener("astro:after-swap", setupNavigation);
</script>
