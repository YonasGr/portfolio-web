---
import careerData from '../data/career.json';
import CareerCard from './career-card.astro';
---

<section id="career" class="section-container relative w-full">
  <div class="space-y-8 sm:space-y-12 md:space-y-16 w-full">
    <!-- Editorial Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-4 sm:gap-6 w-full">
      <div class="max-w-xl">
        <div class="inline-flex items-center gap-2 px-2.5 py-0.5 sm:px-3 sm:py-1 rounded-full text-[11px] sm:text-xs font-mono tracking-widest uppercase text-accent bg-accent/10 border border-accent/20 mb-2 sm:mb-3">
          <span>01</span>
          <span>/</span>
          <span>JOURNEY</span>
        </div>
        <h2 class="text-2xl sm:text-4xl lg:text-5xl font-heading font-bold text-maintext tracking-tight">
          Experience & <span class="text-accent">Education</span>
        </h2>
        <p class="text-subtext font-body text-xs sm:text-base mt-1.5 sm:mt-2 leading-relaxed">
          Track record of technical leadership, full-stack architecture, high-performance systems engineering, and academic foundations.
        </p>
      </div>

      <!-- Quick Timeline Stats -->
      <div class="hidden sm:flex items-center gap-4 text-xs font-mono text-subtext bg-card px-4 py-2.5 rounded-xl border border-card-border">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-accent"></span>
          <span>2018 — Present</span>
        </div>
        <span class="text-card-border">|</span>
        <span>4 Key Milestones</span>
      </div>
    </div>

    <!-- Linear Editorial Vertical Timeline -->
    <div class="relative pl-5 sm:pl-10 md:pl-12 w-full">
      <!-- Continuous Accent Spine on Left -->
      <div 
        class="absolute left-2 sm:left-4 md:left-5 top-3 bottom-6 w-0.5 bg-gradient-to-b from-accent via-accent/40 to-accent/5 pointer-events-none"
        aria-hidden="true"
      ></div>

      <!-- Timeline Entries List -->
      <div class="space-y-6 sm:space-y-10 md:space-y-12 w-full">
        {careerData.map((item, index) => {
          const isFirst = index === 0;

          return (
            <div class="relative w-full">
              <!-- Milestone Node on Spine -->
              <div 
                class="absolute -left-5 sm:-left-10 md:-left-12 top-5 sm:top-6 -translate-x-1/2 flex items-center justify-center z-10"
                aria-hidden="true"
              >
                {isFirst ? (
                  <div class="w-3.5 h-3.5 sm:w-4 sm:h-4 rounded-full bg-accent ring-4 ring-background shadow-xs"></div>
                ) : (
                  <div class="w-3 h-3 sm:w-3.5 sm:h-3.5 rounded-full bg-accent/70 ring-4 ring-background border border-accent/50"></div>
                )}
              </div>

              <!-- Career Card Content -->
              <CareerCard item={item} isFirst={isFirst} />
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>
