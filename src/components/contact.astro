---
import { Icon } from 'astro-icon/components';
import localData from '../data/home.json';

const emailAddress = "yonasgirma222@gmail.com";
const contactSocials = localData.socials.filter(
  (s) => s.showInContact && s.url && s.url !== "#" && s.url !== ""
);

const navLinks = [
  { name: 'Home', href: '#home' },
  { name: 'Experience', href: '#career' },
  { name: 'Projects', href: '#projects' },
  { name: 'Tech Stack', href: '#tech' },
  { name: 'Contact', href: '#contact' }
];
---

<section id="contact" class="section-container relative pb-12 w-full">
  <div class="space-y-8 sm:space-y-12 md:space-y-16 w-full">
    <!-- Editorial Section Header -->
    <div class="max-w-2xl">
      <div class="inline-flex items-center gap-2 px-2.5 py-0.5 sm:px-3 sm:py-1 rounded-full text-[11px] sm:text-xs font-mono tracking-widest uppercase text-accent bg-accent/10 border border-accent/20 mb-2 sm:mb-3">
        <span>04</span>
        <span>/</span>
        <span>GET IN TOUCH</span>
      </div>
      <h2 class="text-2xl sm:text-4xl lg:text-5xl font-heading font-bold text-maintext tracking-tight">
        Let's Build Something <span class="text-accent">Exceptional</span>
      </h2>
      <p class="text-subtext font-body text-xs sm:text-base mt-1.5 sm:mt-2 leading-relaxed">
        Whether you are looking to hire a lead engineer, build an interactive 3D web experience, or scale a cross-platform mobile application, my inbox is always open.
      </p>
    </div>

    <!-- Interactive Contact Deck -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 sm:gap-6 w-full">
      <!-- Direct Email Action Deck (7 Columns) -->
      <div class="lg:col-span-7 p-4 sm:p-6 md:p-8 rounded-2xl bg-card border border-card-border hover:border-accent/40 transition-colors duration-200 flex flex-col justify-between gap-4 sm:gap-6 shadow-sm w-full">
        <div class="space-y-2 sm:space-y-3">
          <div class="inline-flex items-center gap-1.5 text-[11px] sm:text-xs font-mono text-accent uppercase tracking-wider">
            <Icon name="mdi:email-fast-outline" class="w-4 h-4" />
            <span>Direct Email Channel</span>
          </div>
          <h3 class="text-lg sm:text-2xl md:text-3xl font-heading font-bold text-maintext tracking-tight break-all">
            {emailAddress}
          </h3>
          <p class="text-subtext font-body text-xs sm:text-sm leading-relaxed">
            Fastest way to reach me for technical inquiries, project proposals, or engineering roles. Typical response time is under 24 hours.
          </p>
        </div>

        <!-- Action Buttons: 1-Click Copy + Direct Mailto -->
        <div class="flex flex-wrap items-center gap-2 sm:gap-3 pt-1">
          <button
            type="button"
            id="copy-email-btn"
            data-email={emailAddress}
            class="inline-flex items-center justify-center gap-1.5 sm:gap-2 px-3.5 py-2 sm:px-4 sm:py-2.5 rounded-xl bg-accent text-background font-heading font-semibold text-xs sm:text-sm transition-all duration-200 hover:opacity-90 active:scale-[0.98] cursor-pointer"
            aria-label="Copy email address to clipboard"
          >
            <span id="copy-icon">
              <Icon name="mdi:content-copy" class="w-3.5 h-3.5 sm:w-4 sm:h-4" />
            </span>
            <span id="copy-text">Copy to Clipboard</span>
          </button>

          <a
            href={`mailto:${emailAddress}`}
            class="inline-flex items-center justify-center gap-1.5 sm:gap-2 px-3.5 py-2 sm:px-4 sm:py-2.5 rounded-xl bg-card border border-card-border hover:border-accent/40 text-maintext hover:text-accent font-heading font-medium text-xs sm:text-sm transition-all duration-200 active:scale-[0.98]"
          >
            <span>Open Email Client</span>
            <Icon name="mdi:arrow-top-right" class="w-3.5 h-3.5 sm:w-4 sm:h-4" />
          </a>
        </div>
      </div>

      <!-- Availability & Location Status Deck (5 Columns) -->
      <div class="lg:col-span-5 p-4 sm:p-6 md:p-8 rounded-2xl bg-card border border-card-border hover:border-accent/40 transition-colors duration-200 flex flex-col justify-between gap-4 sm:gap-6 shadow-sm w-full">
        <div class="space-y-3 sm:space-y-4">
          <!-- Availability Status -->
          <div class="p-3 sm:p-4 rounded-xl bg-accent/5 border border-accent/15 space-y-1">
            <div class="flex items-center gap-1.5 text-[11px] sm:text-xs font-mono uppercase tracking-wider text-accent font-semibold">
              <span class="w-1.5 h-1.5 sm:w-2 sm:h-2 rounded-full bg-accent"></span>
              <span>Availability Status</span>
            </div>
            <p class="font-heading font-bold text-maintext text-xs sm:text-base">
              Available for Q3/Q4 Projects & Roles
            </p>
            <div class="flex flex-wrap gap-1 pt-0.5 text-[10px] sm:text-[11px] font-mono text-subtext">
              <span class="px-2 py-0.5 rounded bg-background/80 border border-card-border">Full-Time</span>
              <span class="px-2 py-0.5 rounded bg-background/80 border border-card-border">Contract</span>
              <span class="px-2 py-0.5 rounded bg-background/80 border border-card-border">Consulting</span>
            </div>
          </div>

          <!-- Timezone & Location -->
          <div class="space-y-1">
            <span class="text-[10px] sm:text-[11px] font-mono uppercase tracking-wider text-subtext">Current Timezone</span>
            <div class="flex items-center justify-between gap-2">
              <p class="font-heading font-semibold text-maintext text-xs sm:text-base flex items-center gap-1">
                <Icon name="mdi:map-marker" class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-accent" />
                <span>Addis Ababa, Ethiopia</span>
              </p>
              <span class="font-mono text-[10px] sm:text-xs text-accent px-1.5 py-0.5 rounded bg-accent/10 border border-accent/20">
                UTC+3 (EAT)
              </span>
            </div>
            <p class="text-[10px] sm:text-[11px] font-body text-subtext">
              Experienced working with distributed teams across Americas, Europe, and Asia-Pacific.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Direct Social Channels Cards -->
    <div class="space-y-3 sm:space-y-4 w-full">
      <h3 class="text-xs font-mono uppercase tracking-widest text-subtext font-semibold pl-0.5">
        Direct Social & Developer Profiles
      </h3>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-2.5 sm:gap-4 w-full">
        {contactSocials.map((social) => (
          <a
            href={social.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group p-3 sm:p-4 rounded-xl bg-card border border-card-border hover:border-accent/40 hover:bg-accent/5 transition-all duration-200 flex items-center gap-3 w-full"
          >
            <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-lg bg-accent/10 border border-accent/15 flex items-center justify-center text-accent transition-colors duration-200 shrink-0">
              <Icon name={social.icon} class="w-4 h-4 sm:w-5 sm:h-5" />
            </div>

            <div class="overflow-hidden min-w-0 flex-1">
              <h4 class="font-heading font-bold text-maintext text-xs sm:text-sm group-hover:text-accent transition-colors duration-200 truncate">
                {social.name}
              </h4>
              <p class="font-mono text-[11px] sm:text-xs text-subtext truncate">
                {social.handle || social.name}
              </p>
            </div>

            <Icon name="mdi:arrow-top-right" class="w-3.5 h-3.5 sm:w-4 sm:h-4 text-subtext/60 group-hover:text-accent transition-colors duration-200 shrink-0" />
          </a>
        ))}
      </div>
    </div>

    <!-- Editorial Colophon Footer -->
    <footer class="pt-10 sm:pt-16 mt-6 sm:mt-8 border-t border-card-border/60 space-y-6 sm:space-y-8 w-full">
      <div class="flex flex-col md:flex-row items-center justify-between gap-4 sm:gap-6 text-center md:text-left w-full">
        <!-- Brand & Colophon -->
        <div class="space-y-1">
          <div class="flex items-center justify-center md:justify-start gap-2">
            <span class="font-heading font-bold text-maintext text-sm sm:text-base tracking-tight">Yonas Girma</span>
            <span class="text-card-border">•</span>
            <span class="font-mono text-[11px] sm:text-xs text-accent">Full-Stack & Creative Engineer</span>
          </div>
          <p class="text-[11px] sm:text-xs font-body text-subtext max-w-md">
            Crafted with precision using Astro, Tailwind CSS v4, and TypeScript. Deployed on high-speed global Edge infrastructure.
          </p>
        </div>

        <!-- Quick Navigation Anchor Links -->
        <nav class="flex flex-wrap items-center justify-center gap-3 sm:gap-4 text-xs font-heading font-medium text-subtext" aria-label="Footer Navigation">
          {navLinks.map((link) => (
            <a href={link.href} class="hover:text-accent transition-colors duration-200">
              {link.name}
            </a>
          ))}
          <a href="/yonasgr-resume.pdf" target="_blank" class="text-accent hover:underline flex items-center gap-1">
            <span>Resume</span>
            <Icon name="mdi:file-document-outline" class="w-3.5 h-3.5" />
          </a>
        </nav>
      </div>

      <!-- Bottom Bar: Copyright & Back-to-Top Trigger -->
      <div class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-4 sm:pt-6 border-t border-card-border/40 text-[11px] sm:text-xs font-mono text-subtext w-full">
        <p>© 2026 Yonas Girma. All rights reserved.</p>

        <a 
          href="#home"
          class="inline-flex items-center gap-1 text-subtext hover:text-accent transition-colors duration-200"
          aria-label="Return to top of page"
        >
          <span>Back to Top</span>
          <Icon name="mdi:arrow-up" class="w-3.5 h-3.5" />
        </a>
      </div>
    </footer>
  </div>

  <!-- Toast Notification for Clipboard Copy Feedback -->
  <div 
    id="copy-toast" 
    class="fixed bottom-20 sm:bottom-8 left-1/2 -translate-x-1/2 z-50 pointer-events-none opacity-0 translate-y-2 transition-all duration-200 flex items-center gap-2 px-4 py-2 rounded-full bg-card border border-accent/40 shadow-xl backdrop-blur-xl text-xs sm:text-sm font-heading font-medium text-maintext"
    role="status"
    aria-live="polite"
  >
    <Icon name="mdi:check-circle" class="w-4 h-4 text-accent" />
    <span>Email copied to clipboard!</span>
  </div>
</section>

<script>
  function setupContact() {
    const copyBtn = document.getElementById('copy-email-btn');
    const copyText = document.getElementById('copy-text');
    const toast = document.getElementById('copy-toast');
    let toastTimeout: number | null = null;

    if (copyBtn) {
      copyBtn.addEventListener('click', async () => {
        const email = copyBtn.getAttribute('data-email') || 'yonasgirma222@gmail.com';

        try {
          if (navigator.clipboard) {
            await navigator.clipboard.writeText(email);
          } else {
            const textArea = document.createElement('textarea');
            textArea.value = email;
            textArea.style.position = 'fixed';
            textArea.style.opacity = '0';
            document.body.appendChild(textArea);
            textArea.focus();
            textArea.select();
            try {
              (document as unknown as { execCommand: (cmd: string) => boolean }).execCommand?.('copy');
            } catch {
              // Ignore
            }
            document.body.removeChild(textArea);
          }

          if (copyText) copyText.textContent = 'Copied!';
          copyBtn.classList.add('bg-emerald-500', 'text-white');
          copyBtn.classList.remove('bg-accent', 'text-background');

          if (toast) {
            toast.classList.remove('opacity-0', 'translate-y-2');
            toast.classList.add('opacity-100', 'translate-y-0');

            if (toastTimeout) clearTimeout(toastTimeout);
            toastTimeout = window.setTimeout(() => {
              toast.classList.remove('opacity-100', 'translate-y-0');
              toast.classList.add('opacity-0', 'translate-y-2');
            }, 2000);
          }

          setTimeout(() => {
            if (copyText) copyText.textContent = 'Copy to Clipboard';
            copyBtn.classList.remove('bg-emerald-500', 'text-white');
            copyBtn.classList.add('bg-accent', 'text-background');
          }, 2000);
        } catch (err) {
          console.error('Failed to copy email to clipboard', err);
        }
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupContact);
  } else {
    setupContact();
  }

  document.addEventListener('astro:after-swap', setupContact);
</script>