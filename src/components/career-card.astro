---
interface Props {
  item: {
    company: string;
    role: string;
    period: string;
    type?: string;
    location?: string;
    description: string;
    achievements?: string[];
    skills?: string[];
  };
  isFirst?: boolean;
  index?: number;
}

const { item, isFirst = false, index = 0 } = Astro.props;

// Extract the year from the period string
const yearMatch = item.period.match(/\d{4}/);
const yearLabel = yearMatch ? yearMatch[0] : '—';
---

<div
  class="career-row group w-full py-8 sm:py-10 cursor-default"
  style="border-bottom: 1px solid var(--border); transition: background 0.2s ease;"
>
  <div class="grid grid-cols-1 lg:grid-cols-[120px_1fr_auto] gap-4 sm:gap-6 lg:gap-10 items-start">

    <!-- Year number — large muted typographic element -->
    <div class="hidden lg:block">
      <span
        class="font-heading font-black leading-none select-none text-year"
        style="font-size: 3.5rem; color: var(--text-3); transition: color 0.2s;"
      >
        {yearLabel}
      </span>
    </div>

    <!-- Main content -->
    <div class="space-y-3">
      <!-- Role + company + badges -->
      <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1.5">
        <h3
          class="font-heading font-black tracking-tight leading-none"
          style="font-size: clamp(1.15rem, 2.5vw, 1.5rem); color: var(--text-1); transition: color 0.2s;"
        >
          {item.role}
        </h3>
        <span class="font-heading font-semibold text-sm sm:text-base" style="color: var(--accent);">
          @ {item.company}
        </span>
        {isFirst && (
          <span
            class="inline-flex items-center px-2.5 py-0.5 rounded-full font-mono text-[10px] tracking-wider uppercase font-semibold"
            style="background: var(--accent-dim); color: var(--accent); border: 1px solid rgba(var(--accent-rgb),0.25);"
          >
            Current
          </span>
        )}
      </div>

      <!-- Meta: period, type, location (mobile year here) -->
      <div class="flex flex-wrap items-center gap-2 font-mono text-[11px]" style="color: var(--text-2);">
        <span class="lg:hidden font-bold" style="color: var(--text-3);">{yearLabel}</span>
        {item.period && <span>{item.period}</span>}
        {item.type && (
          <>
            <span style="color: var(--text-3);">·</span>
            <span>{item.type}</span>
          </>
        )}
        {item.location && (
          <>
            <span style="color: var(--text-3);">·</span>
            <span>{item.location}</span>
          </>
        )}
      </div>

      <!-- Description -->
      <p class="font-body text-sm sm:text-base leading-relaxed max-w-3xl" style="color: var(--text-2);">
        {item.description}
      </p>

      <!-- Achievements -->
      {item.achievements && item.achievements.length > 0 && (
        <ul class="space-y-1.5 pt-1">
          {item.achievements.map(a => (
            <li class="flex items-start gap-2 font-body text-sm leading-relaxed" style="color: var(--text-2);">
              <span class="mt-1 shrink-0 w-1 h-1 rounded-full" style="background: var(--accent);"></span>
              {a}
            </li>
          ))}
        </ul>
      )}

      <!-- Skills -->
      {item.skills && item.skills.length > 0 && (
        <div class="flex flex-wrap gap-1.5 pt-1">
          {item.skills.map((s: string) => (
            <span class="tag">{s}</span>
          ))}
        </div>
      )}
    </div>

    <!-- Right: index number (decorative) -->
    <div class="hidden lg:flex items-start pt-1">
      <span
        class="font-mono text-xs tracking-widest"
        style="color: var(--text-3);"
      >
        0{index + 1}
      </span>
    </div>
  </div>
</div>

<style>
  .career-row:hover {
    background: var(--surface);
    padding-left: 1rem;
    padding-right: 1rem;
    margin-left: -1rem;
    margin-right: -1rem;
  }

  .career-row:hover h3 {
    color: var(--accent) !important;
  }

  .career-row:hover .text-year {
    color: var(--text-2) !important;
  }
</style>
