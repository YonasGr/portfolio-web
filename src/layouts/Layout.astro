---
import '../styles/global.css';
import { SITE_CONFIG } from '../config.ts';
import favicon from '../assets/Y-Logo.png';
import SpeedInsights from "@vercel/speed-insights/astro";

interface Props {
  title: string;
}

const { title } = Astro.props;

const baseTheme = SITE_CONFIG.baseTheme;
const defaultTheme = `${baseTheme}-dark`;
---

<!doctype html>
<html lang="en" class="scroll-smooth overflow-x-hidden w-full max-w-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href={favicon.src} />
    <title>{title}</title>

    <!-- THEME PERSISTENCE SCRIPT (Inline to prevent flash of unstyled theme) -->
    <script is:inline define:vars={{ defaultTheme }}>
      (function() {
        const validThemes = [
          'default-dark', 'default-light',
          'strategic-dark', 'strategic-light',
          'innovator-dark', 'innovator-light',
          'executive-dark', 'executive-light'
        ];
        try {
          const savedTheme = localStorage.getItem('theme');
          if (savedTheme && validThemes.includes(savedTheme)) {
            document.documentElement.setAttribute('data-theme', savedTheme);
          } else {
            document.documentElement.setAttribute('data-theme', defaultTheme);
            localStorage.setItem('theme', defaultTheme);
          }
        } catch (e) {
          document.documentElement.setAttribute('data-theme', defaultTheme);
        }
      })();
    </script>
  </head>
  <body class="bg-background text-maintext relative min-h-screen w-full max-w-full overflow-x-hidden antialiased selection:bg-accent selection:text-background">
    <!-- Ambient Background Lighting & Subtle Pattern Mesh -->
    <div class="fixed inset-0 -z-10 pointer-events-none overflow-hidden" aria-hidden="true">
      <div 
        class="absolute -top-[25%] left-1/2 -translate-x-1/2 w-[90vw] max-w-[800px] h-[400px] sm:h-[550px] rounded-full blur-[100px] sm:blur-[140px] opacity-20 transition-colors duration-500"
        style="background: radial-gradient(circle, var(--color-accent) 0%, transparent 70%);"
      ></div>
      <div 
        class="absolute top-[35%] -left-[15%] w-[55vw] max-w-[500px] h-[350px] sm:h-[500px] rounded-full blur-[100px] sm:blur-[160px] opacity-15 transition-colors duration-500"
        style="background: radial-gradient(circle, var(--color-accent) 0%, transparent 70%);"
      ></div>
      <div 
        class="absolute top-[70%] -right-[15%] w-[55vw] max-w-[500px] h-[350px] sm:h-[500px] rounded-full blur-[100px] sm:blur-[160px] opacity-15 transition-colors duration-500"
        style="background: radial-gradient(circle, var(--color-accent) 0%, transparent 70%);"
      ></div>
      <div 
        class="absolute inset-0 opacity-[0.02]"
        style="background-image: radial-gradient(var(--color-maintext) 1px, transparent 1px); background-size: 36px 36px;"
      ></div>
    </div>

    <!-- Main Content Container -->
    <main class="px-4 sm:px-6 md:px-12 lg:px-20 max-w-7xl mx-auto relative z-0 w-full">
      <slot />
    </main>

    <!-- Floating Back-to-Top with Circular Scroll Progress Ring -->
    <button
      id="to-top"
      class="fixed bottom-4 right-4 sm:bottom-8 sm:right-8 z-40 p-0 rounded-full bg-card border border-card-border shadow-lg transition-all duration-300 translate-y-16 opacity-0 pointer-events-none group flex items-center justify-center cursor-pointer hover:border-accent/40 backdrop-blur-md"
      aria-label="Back to top"
    >
      <svg class="w-10 h-10 sm:w-12 sm:h-12 -rotate-90">
        <circle cx="20" cy="20" r="17" sm:cx="24" sm:cy="24" sm:r="20" fill="none" stroke="currentColor" stroke-width="2.5" class="text-accent/15"></circle>
        <circle
          id="progress-circle"
          cx="20" cy="20" r="17"
          fill="none"
          stroke="currentColor" 
          stroke-width="2.5"
          stroke-dasharray="106.8"
          stroke-dashoffset="106.8"
          stroke-linecap="round"
          class="text-accent transition-all duration-100"
        ></circle>
      </svg>
      
      <div class="absolute text-accent">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="w-4 h-4 sm:w-5 sm:h-5" fill="currentColor">
          <path d="M13.0001 7.82843V20H11.0001V7.82843L5.63614 13.1924L4.22192 11.7782L12.0001 4L19.7783 11.7782L18.3641 13.1924L13.0001 7.82843Z"></path>
        </svg>
      </div>
    </button>

    <script>
      const toTopBtn = document.getElementById('to-top');
      const progressCircle = document.getElementById('progress-circle');
      const circumference = 106.814; // 2 * pi * 17

      function handleScroll() {
        const scrollHeight = document.documentElement.scrollHeight - window.innerHeight;
        if (scrollHeight <= 0) return;
        const scrollPercentage = Math.min(1, Math.max(0, window.scrollY / scrollHeight));
        
        // Update Circle Progress
        const offset = circumference - (scrollPercentage * circumference);
        if (progressCircle) {
          progressCircle.style.strokeDashoffset = offset.toString();
        }

        // Visibility Logic
        if (window.scrollY > 300) {
          toTopBtn?.classList.remove('translate-y-16', 'opacity-0', 'pointer-events-none');
          toTopBtn?.classList.add('translate-y-0', 'opacity-100');
        } else {
          toTopBtn?.classList.add('translate-y-16', 'opacity-0', 'pointer-events-none');
          toTopBtn?.classList.remove('translate-y-0', 'opacity-100');
        }
      }

      window.addEventListener('scroll', handleScroll, { passive: true });
      handleScroll();

      toTopBtn?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    </script>
    <SpeedInsights />
  </body>
</html>